
[Unit]
Description=System Health Monitor & Security Daemon
After=network.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=auditmanager
ExecStart=/usr/local/bin/USAGEd/src/sysaudit.sh --scan --cleanup
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target


