
[Unit]
Description=Timer for System Health Monitor and Security Daemon
Requires=sysaudit.service

[Timer]
OnBootSec=15min
OnUnitActiveSec=3d
Persistent=true

[Install]
WantedBy=timers.target

[Service]
Type=simple
User=auditmanager
ExecStart=/usr/local/bin/sysaudit.sh
Restart=on-failure
RestartSec=10s
StartLimitIntervalSec=60s
StartLimitBurst=3

